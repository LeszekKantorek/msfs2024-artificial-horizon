# Generated by Cargo
# will have compiled files and executables
debug
target
node_modules/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# Local context session metadata and Python hook caches
.context/sessions/
.context/sessions.log
.context/.sessions.lock
__pycache__/
*.pyc

# Local work and additional skills
/.local/
# Microsoft SDK artifacts are obtained separately, never versioned.
SimConnect.h
SimConnect*.lib
SimConnect*.dll
Microsoft.FlightSimulator.SimConnect.dll
/.agents/skills/*/
!/.agents/skills/context-preserve/
!/.agents/skills/context-review-sessions/
!/.agents/skills/context-map/
!/.agents/skills/context-maintain/
!/.agents/skills/context-diagnose/
!/.agents/skills/context-compile/
!/.agents/skills/procedural-skill-creator/
!/.agents/skills/project-plan-change/
!/.agents/skills/project-diagnose-failure/
!/.agents/skills/project-validate-presentation/
!/.agents/skills/project-prepare-pr/
!/.agents/skills/project-review-change/
!/.agents/skills/project-decide-architecture/
!/.agents/skills/technical-writing-rules/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
